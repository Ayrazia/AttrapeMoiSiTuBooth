---
import LegalLayout from '../layouts/LegalLayout.astro';
import { contact, legal } from '../data/site.js';
---

<LegalLayout
  heading="Mentions légales"
  description="Mentions légales du site Attrape Moi Si Tu Booth."
>
  <h2>Éditeur du site</h2>
  <p>
    Le présent site est édité par&nbsp;:
  </p>
  <ul>
    <li>
      <strong>{legal.responsable}</strong>, {legal.statut}, exerçant sous le nom
      commercial « {legal.exploitant} »
    </li>
    <li>Responsable de la publication : {legal.responsable}</li>
    <li>SIRET : {legal.siret}</li>
    {legal.rcs && <li>{legal.rcs}</li>}
    {legal.tva && <li>N° TVA intracommunautaire : {legal.tva}</li>}
    {!legal.tva && legal.franchiseTva && <li>TVA non applicable, art. 293 B du CGI</li>}
    <li>Adresse : {legal.adresse}, {legal.codePostalVille}</li>
    <li>Téléphone : <a href={contact.phoneHref}>{contact.phone}</a></li>
    <li>Email : <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
  </ul>

  <h2>Hébergement</h2>
  <p>
    Le site est hébergé par <strong>{legal.hebergeur}</strong> —
    {legal.hebergeurAdresse} — Tél. : {legal.hebergeurTel} —
    <a href={legal.hebergeurSite} target="_blank" rel="noopener">{legal.hebergeurSite}</a>.
  </p>
  <p>
    Le formulaire de contact est traité par un service hébergé en France chez
    <strong>{legal.relaisHebergeur}</strong>, et les emails sont acheminés par
    Brevo (Sendinblue SAS, France). Voir la
    <a href={`${import.meta.env.BASE_URL}confidentialite/`}>politique de confidentialité</a>.
  </p>

  {
    legal.mediateur && (
      <>
        <h2>Médiation de la consommation</h2>
        <p>
          Conformément aux articles L.611-1 et suivants du Code de la consommation,
          en cas de litige non résolu à l'amiable, le client consommateur peut
          recourir gratuitement au médiateur de la consommation suivant :
          <strong>{legal.mediateur}</strong>
          {legal.mediateurSite && (
            <span>
              {' '}— <a href={legal.mediateurSite} target="_blank" rel="noopener">{legal.mediateurSite}</a>
            </span>
          )}.
        </p>
      </>
    )
  }

  <h2>Propriété intellectuelle</h2>
  <p>
    L'ensemble des éléments du site (textes, logo, photographies, mise en page,
    graphismes) est la propriété de {legal.exploitant}, sauf mention contraire,
    et est protégé par le droit de la propriété intellectuelle. Toute
    reproduction, représentation ou diffusion, totale ou partielle, sans
    autorisation écrite préalable, est interdite.
  </p>

  <h2>Crédits</h2>
  <p>
    Photographies : {legal.exploitant}. Création du site et visuels de la marque :
    {legal.exploitant}.
  </p>

  <h2>Contact</h2>
  <p>
    Pour toute question concernant le site ou ces mentions légales, vous pouvez
    nous écrire à <a href={`mailto:${contact.email}`}>{contact.email}</a>.
  </p>
</LegalLayout>
