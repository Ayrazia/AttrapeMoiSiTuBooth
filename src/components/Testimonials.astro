---
import { testimonials, references } from '../data/site.js';

const withLogo = references.filter((r) => r.logo);
const textOnly = references.filter((r) => !r.logo).map((r) => r.label);
---

<section class="section testimonials" id="avis">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Ils nous ont fait confiance</span>
      <h2 class="section-title">Vos sourires, notre récompense</h2>
    </div>

    <div class="quotes">
      {
        testimonials.map((t) => (
          <figure class="quote reveal">
            <div class="stars" aria-label="5 étoiles sur 5">★★★★★</div>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <strong>{t.author}</strong>
              <span>{t.event}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="refs reveal">
      <p class="refs-label">Partenaires &amp; lieux d'exception&nbsp;:</p>

      <div class="logo-wall">
        {
          withLogo.map((r) => {
            const img = (
              <img class="logo-img" src={r.logo} alt={r.label} loading="lazy" />
            );
            return r.url ? (
              <a class="logo-chip" href={r.url} target="_blank" rel="noopener" aria-label={r.label}>
                {img}
              </a>
            ) : (
              <div class="logo-chip" title={r.label}>{img}</div>
            );
          })
        }
      </div>

      {
        textOnly.length > 0 && (
          <p class="refs-more">
            …et aussi&nbsp;: {textOnly.join(' · ')}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--noir);
    color: var(--creme);
  }

  .testimonials .section-title {
    color: var(--creme);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }

  .quote {
    background: var(--noir-soft);
    border: 1px solid rgba(246, 241, 233, 0.1);
    border-radius: var(--radius);
    padding: 2rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stars {
    color: var(--or-clair);
    letter-spacing: 0.15em;
    font-size: 0.95rem;
  }

  blockquote {
    font-family: var(--font-titre);
    font-size: 1.12rem;
    line-height: 1.5;
    color: rgba(246, 241, 233, 0.94);
    flex: 1;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(246, 241, 233, 0.12);
    padding-top: 1rem;
  }

  figcaption strong {
    font-weight: 600;
  }

  figcaption span {
    font-size: 0.85rem;
    color: var(--or-clair);
  }

  .refs {
    margin-top: 3.2rem;
    text-align: center;
  }

  .refs-label {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(246, 241, 233, 0.55);
    margin-bottom: 1.2rem;
  }

  /* Tous les logos sur une seule ligne (défilement horizontal si trop étroit) */
  .logo-wall {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    overflow-x: auto;
    padding: 4px 2px 8px;
    scrollbar-width: thin;
  }

  .logo-chip {
    flex: 0 0 auto;
    height: 68px;
    min-width: 84px;
    padding: 0 0.9rem;
    background: #ffffff;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  a.logo-chip:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.6);
  }

  .logo-img {
    max-height: 42px;
    max-width: 108px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .refs-more {
    margin-top: 1.6rem;
    font-size: 0.95rem;
    color: rgba(246, 241, 233, 0.6);
  }
</style>
