---
import { brand, contact } from '../data/site.js';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

const legalLinks = [
  { href: `${base}mentions-legales/`, label: 'Mentions légales' },
  { href: `${base}confidentialite/`, label: 'Confidentialité' },
  { href: `${base}conditions-utilisation/`, label: "Conditions d'utilisation" },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${import.meta.env.BASE_URL}images/logo.jpg`} alt="" width="52" height="52" />
      <div>
        <strong>{brand.name}</strong>
        <p>{brand.tagline}</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Pied de page">
      <a href={`${base}#prestations`}>Prestations</a>
      <a href={`${base}#galerie`}>Galerie</a>
      <a href={`${base}#avis`}>Avis</a>
      <a href={`${base}#contact`}>Contact</a>
    </nav>

    <div class="footer-contact">
      <a href={contact.phoneHref}>{contact.phone}</a>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={contact.instagramUrl} target="_blank" rel="noopener">
        Instagram @{contact.instagram}
      </a>
    </div>
  </div>

  <nav class="container footer-legal" aria-label="Pages légales">
    {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <div class="container footer-bottom">
    <span>© {year} {brand.name}. Tous droits réservés.</span>
    <span>{contact.zone}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--noir);
    color: rgba(246, 241, 233, 0.8);
    padding: 3.5rem 0 2rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(246, 241, 233, 0.12);
  }

  .footer-brand {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }

  .footer-brand img {
    border-radius: 50%;
  }

  .footer-brand strong {
    font-family: var(--font-titre);
    font-size: 1.15rem;
    color: var(--creme);
  }

  .footer-brand p {
    font-size: 0.88rem;
    color: rgba(246, 241, 233, 0.6);
  }

  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.92rem;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--or-clair);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
  }

  .footer-legal a {
    color: rgba(246, 241, 233, 0.7);
  }

  .footer-legal a:hover {
    color: var(--or-clair);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1.2rem;
    font-size: 0.82rem;
    color: rgba(246, 241, 233, 0.5);
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
  }
</style>
