---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, legal } from '../data/site.js';

const { heading, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const title = `${heading} — ${brand.name}`;
---

<Layout title={title} description={description}>
  <Header solid={true} />

  <main class="legal">
    <div class="legal-container">
      <a class="legal-back" href={base}>← Retour à l'accueil</a>
      <h1>{heading}</h1>
      <p class="legal-updated">Dernière mise à jour : {legal.updated}</p>
      <article class="legal-content">
        <slot />
      </article>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .legal {
    background: var(--creme);
    padding: 120px 0 80px;
  }

  .legal-container {
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    padding: 0 clamp(1.2rem, 4vw, 2rem);
  }

  .legal-back {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--or);
    margin-bottom: 1.5rem;
  }

  .legal-back:hover {
    color: var(--noir);
  }

  .legal h1 {
    font-family: var(--font-titre);
    font-size: clamp(2rem, 5vw, 2.8rem);
    color: var(--noir);
    margin-bottom: 0.4rem;
  }

  .legal-updated {
    font-size: 0.85rem;
    color: var(--texte-doux);
    margin-bottom: 2.5rem;
  }

  .legal-content {
    color: var(--texte);
    line-height: 1.7;
  }

  .legal-content h2 {
    font-family: var(--font-titre);
    font-size: 1.4rem;
    color: var(--noir);
    margin: 2.2rem 0 0.8rem;
  }

  .legal-content h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--noir);
    margin: 1.4rem 0 0.4rem;
  }

  .legal-content p {
    margin: 0 0 1rem;
  }

  .legal-content ul {
    margin: 0 0 1rem;
    padding-left: 1.3rem;
  }

  .legal-content li {
    margin-bottom: 0.4rem;
  }

  .legal-content a {
    color: var(--or);
    text-decoration: underline;
  }

  .legal-content a:hover {
    color: var(--noir);
  }

  .legal-content strong {
    color: var(--noir);
  }
</style>
