# Modèle de configuration du relais mail.
# Copie ce fichier en .env et remplis les valeurs :  cp .env.dist .env
# ⚠️ Ne commite JAMAIS le .env (il contient ton mot de passe SMTP).
# Sur Vercel/Netlify/Render : renseigne plutôt ces variables dans le dashboard.

# --- SMTP Brevo ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=ba654f001@smtp-brevo.com
# Clé/mot de passe SMTP Brevo (SMTP & API → SMTP)
BREVO_SMTP_PASS=colle_ta_cle_smtp_brevo_ici

# --- Adresses ---
# Email qui reçoit les demandes
CONTACT_TO=attrape.moisi.tubooth@outlook.com
# Expéditeur VÉRIFIÉ dans Brevo (Expéditeurs, domaines & IP)
CONTACT_FROM=ton_expediteur_verifie@exemple.com

# --- Divers ---
# Origine autorisée (ton site). Laisse tel quel pour GitHub Pages.
ALLOWED_ORIGIN=https://ayrazia.github.io
# Port du serveur autonome (server.js). Ignoré sur Vercel/Netlify.
PORT=3000
