# Modèle de configuration du relais mail.
# - Sur le VPS : ces variables vont dans /etc/attrape-contact.env (droits 600,
#   lu par le service systemd). Voir deploy/README.md.
# - En local (test) : cp .env.dist .env, remplis, puis npm start.
# ⚠️ Ne commite JAMAIS un fichier contenant ton mot de passe SMTP.

# --- SMTP Brevo ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=ba654f001@smtp-brevo.com
# Clé/mot de passe SMTP Brevo (SMTP & API → SMTP)
BREVO_SMTP_PASS=colle_ta_cle_smtp_brevo_ici

# --- Adresses ---
# Email(s) qui reçoivent les demandes — plusieurs adresses : séparer par des virgules
# ex. CONTACT_TO=attrape.moisi.tubooth@outlook.com, autre@exemple.fr
CONTACT_TO=attrape.moisi.tubooth@outlook.com
# Expéditeur VÉRIFIÉ dans Brevo (Expéditeurs, domaines & IP)
CONTACT_FROM=ton_expediteur_verifie@exemple.com

# --- (Optionnel) Ajout automatique à une liste Brevo ---
# Uniquement pour les personnes qui ont coché la case « offres et actualités ».
# Laisse vide pour désactiver (le consentement reste indiqué dans le mail reçu).
# Clé API Brevo (SMTP & API → Clés API) — différente du mot de passe SMTP
BREVO_API_KEY=
# ID numérique de la liste (Contacts → Listes)
BREVO_LIST_ID=

# --- Divers ---
# Origine autorisée (ton site)
ALLOWED_ORIGIN=https://attrapemoisitubooth.fr
# Adresse et port d'écoute du serveur (server.js)
# 127.0.0.1 = uniquement en local, derrière Caddy (cas du VPS)
HOST=127.0.0.1
PORT=3000
